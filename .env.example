# Copy to .env for local dev. On Heroku these are config vars.
NODE_ENV=development
TEMPO_NETWORK=moderato            # moderato (testnet) | tempo (mainnet)
TEMPO_RPC_URL=                    # optional primary RPC (e.g. your dRPC key URL); defaults to the public RPC
TEMPO_RPC_FALLBACK_URLS=          # optional comma-separated backups; defaults to public endpoints
PAYMENT_TOKEN=                    # optional; defaults: pathUSD on moderato, USDC.e on tempo
TREASURY_ADDRESS=
HOT_WALLET_PRIVATE_KEY=            # 0x… EOA that pays providers (keep only a few days of float)
HOT_WALLET_DAILY_LIMIT_USD=20
MOCK_PROVIDERS=auto               # auto = mock on testnet
FEE_PAYER_URL=
MPP_SECRET_KEY=                   # 32+ random chars; binds MPP challenges to this server
OPERATOR_PRIVATE_KEY=             # 0x… signs channel settle/close + sponsors open fees (defaults to the hot wallet)
SPONSOR_FEES=true
REVENUE_TO=operator               # operator = payments land in the operator/hot wallet, which pays fees and sweeps profit; treasury = straight to TREASURY_ADDRESS
PROFIT_ADDRESS=                   # optional; profit goes here (defaults to TREASURY_ADDRESS)
HOT_WALLET_FLOAT_USD=10           # kept in the revenue wallet for provider payments and fees
PROFIT_SWEEP_MIN_USD=20           # sweep as soon as profit reaches this…
PROFIT_SWEEP_INTERVAL_HOURS=24    # …or at least this often
RELAY_API_KEY=                    # optional (relay.link): Solana deposits + higher limits for cross-chain moves
SPONSOR_TX_PER_DAY=20             # wallet transactions per user per day whose network fee SmartRouter pays
SEND_MAX_USD=1000
DATABASE_URL=postgres://localhost:5432/smartrouter
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-to-32+-random-chars-please
PRIVY_APP_ID=                     # public Privy app id (sign-in with email / Google)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                    # public bucket URL (https://pub-….r2.dev)
AA_API_KEY=
SENTRY_DSN=
MAX_PROVIDER_PRICE_MULTIPLIER=2
FEE_PCT=10
DEFAULT_ALLOCATION_USD=2
# Free fallback model
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
FREE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
GROQ_FREE_API_KEY=
FREE_DAILY_MESSAGES=30
FREE_GLOBAL_DAILY_USD=3
FREE_CONTEXT_TOKENS=4000
FREE_MAX_OUTPUT_TOKENS=512
CHAT_CONTEXT_TOKENS=8000
APP_ORIGINS=http://localhost:5173   # comma-separated frontend origins (CORS + SIWE domain)
